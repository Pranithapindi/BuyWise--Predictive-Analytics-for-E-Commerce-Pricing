# ═══════════════════════════════════════════════════════════════
# Product Price Tracker — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── App ─────────────────────────────────────────────────────────
DEBUG=false
SECRET_KEY=your-super-secret-key-at-least-32-chars-long

# ── Database (PostgreSQL) ────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=price_tracker
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/price_tracker
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/price_tracker

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Email (Gmail SMTP) ───────────────────────────────────────────
# Create an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAILS_FROM_NAME=PriceTracker

# ── CORS ─────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ── Scraper ──────────────────────────────────────────────────────
SCRAPER_TIMEOUT=30
SCRAPER_MAX_RETRIES=3
SCRAPER_RETRY_DELAY=5

# ── ML ───────────────────────────────────────────────────────────
ML_MODELS_DIR=ml_models
MIN_HISTORY_POINTS=5
